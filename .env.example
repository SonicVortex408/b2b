# Optional: enables Claude for the AI booking assistant. Without it a deterministic parser is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase backend. Leave the two NEXT_PUBLIC vars empty to run fully in-browser (demo mode).
NEXT_PUBLIC_SUPABASE_URL=https://ttkfwhjwzxpmeevjiitu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Settings → API Keys → publishable key (sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=            # Settings → API Keys → secret key (sb_secret_…). Server only, never commit.
SUPABASE_DB_URL=                      # Connect → connection string (only for `npm run db:migrate`)
DEMO_PASSWORD=                        # password for the 4 @xie.demo accounts created by `npm run db:seed`
NEXT_PUBLIC_DEMO_PASSWORD=            # optional: pre-fills the sign-in form for demos

# Signed QR check-in tokens (HS256, 60 s TTL, per-room secret derived from this)
QR_SECRET=change-me

# OR-Tools CP-SAT solver service (solver/). Without it, optimisation falls back to a greedy pass.
SOLVER_URL=http://localhost:8080

# Integrations (integrations/README.md)
TELEGRAM_BOT_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

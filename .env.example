# Optional: enables Claude for the AI booking assistant. Without it a deterministic parser is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 1 production backend (see supabase/migrations). Not required for the demo build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
